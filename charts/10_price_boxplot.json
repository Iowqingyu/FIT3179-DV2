{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Six horizontal price box plots. Coloured dots represent individual sample prices; boxes span Q1–Q3; dark strokes show medians; diamonds indicate means; whiskers use 1.5×IQR fences.",
  "background": "transparent",
  "width": 570,
  "height": 420,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#362b23",
      "titleColor": "#362b23",
      "gridColor": "#e7dcc8",
      "labelFontSize": 14,
      "titleFontSize": 15
    },
    "font": "DM Sans, Arial, sans-serif",
    "legend": {
      "labelColor": "#362b23",
      "titleColor": "#362b23",
      "labelFontSize": 14,
      "titleFontSize": 15
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/price_box_stats.csv"
      },
      "mark": {
        "type": "rule",
        "color": "#374047",
        "strokeWidth": 1.7,
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "whisker_min",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "nice": false
          },
          "axis": {
            "tickCount": 9,
            "format": "$,.0f",
            "labelFontSize": 15,
            "titleFontSize": 16
          },
          "title": "Listed package price (AUD)"
        },
        "x2": {
          "field": "whisker_max"
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": [
            "Bakery",
            "Dairy, eggs & fridge",
            "Drinks",
            "Fruit & vegetables",
            "Meat & seafood",
            "Pantry"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 15,
            "labelLimit": 205,
            "labelPadding": 12
          }
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Department"
          },
          {
            "field": "q1",
            "type": "quantitative",
            "title": "Lower Quartile (A$)",
            "format": ".2f"
          },
          {
            "field": "median",
